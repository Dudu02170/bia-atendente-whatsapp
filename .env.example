# Copie para .env e preencha. Nunca suba o .env para o GitHub.
COMPOSE_PROJECT_NAME=bia

# PostgreSQL
POSTGRES_USER=bia
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bia
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bia:troque-esta-senha@postgres:5432/bia

# Redis
REDIS_PORT=6379
REDIS_PREFIX=bia

# Evolution API (WhatsApp)
EVOLUTION_API_PORT=8080
EVOLUTION_API_KEY=gere-uma-chave-aleatoria
EVOLUTION_INSTANCE_NAME=bia
SESSION_CLIENT_NAME=Bia
WPP_LID_MODE=false
CONFIG_SESSION_PHONE_VERSION=2.2412.54

# n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=troque-esta-senha
N8N_ENCRYPTION_KEY=gere-uma-chave-aleatoria
WEBHOOK_URL=http://localhost:5678

# IA
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sua-chave-da-anthropic
AI_MODEL=claude-sonnet-4-6
